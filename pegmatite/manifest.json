{
  "manifest_version": 3,
  "name": "Pegmatite",
  "version": "1.7.0",
  "description": "Shows graphs and diagrams rendered by PlantUML.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://github.com/*",
    "https://gist.github.com/*",
    "https://gitlab.com/*",
    "https://bitbucket.org/*",
    "https://*.backlog.jp/wiki/*",
    "https://*.cloudmine.jp/*"
  ],
  "options_ui": {
    "page": "options.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": ["pako_deflate.min.js", "content-script.js"],
      "matches": [
        "https://github.com/*",
        "https://gist.github.com/*",
        "https://gitlab.com/*",
        "https://bitbucket.org/*",
        "https://*.backlog.jp/wiki/*",
        "https://*.cloudmine.jp/*"
      ]
    }
  ]
}
